{
  "name": "open-council",
  "version": "0.1.0",
  "description": "Open Council — Multi-model debate orchestration system",
  "type": "module",
  "bin": {
    "council": "bin/council.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "council",
    "debate",
    "multi-model",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@mariozechner/pi-ai": "^0.62.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^12.0.0",
    "ink": "^7.0.1",
    "react": "^19.2.5",
    "yaml": "^2.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
