{
  "name": "@open-council/cli",
  "version": "0.1.0",
  "description": "Open Council — Multi-model debate orchestration system",
  "type": "module",
  "bin": {
    "council": "bin/council.js"
  },
  "files": [
    "dist",
    "bin",
    "web",
    "defaults"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "keywords": [
    "ai",
    "council",
    "debate",
    "multi-model",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@hono/node-server": "^2.0.8",
    "@inquirer/prompts": "^7.0.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^12.0.0",
    "hono": "^4.12.27",
    "ink": "^7.0.1",
    "openai": "^6.45.0",
    "react": "^19.2.5",
    "yaml": "^2.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "2.1.9",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
